{
  "name": "painel-silos",
  "version": "2.3.0",
  "private": true,
  "description": "Painel de monitoramento de nível dos silos de leite",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:servidor": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm start --workspace server",
    "test": "npm test --workspace server",
    "usuario": "npm run usuario --workspace server --",
    "servico": "npm run servico --workspace server --",
    "telegram": "npm run telegram --workspace server --"
  }
}
