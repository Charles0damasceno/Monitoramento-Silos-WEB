# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O .env NÃO vai para o git.

# ---- Servidor web ----
PORT=12322
# 0.0.0.0 = acessível pela rede da fábrica; 127.0.0.1 = só neste computador
HOST=0.0.0.0

# ---- Origem dos dados ----
# mysql     = lê a tabela da IHM (produção)
# simulador = dados de demonstração, com aviso "SIMULAÇÃO" na tela
FONTE_DADOS=mysql

# ---- Banco da IHM (somente leitura) ----
DB_HOST=10.5.0.111
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=weintek
DB_TABELA=silo

# ---- Leitura e histórico ----
# Intervalo de leitura do banco (segundos)
LEITURA_INTERVALO_S=2
# A cada quantos segundos gravar um ponto no histórico
HISTORICO_INTERVALO_S=30
# Por quantos dias manter o histórico
HISTORICO_RETENCAO_DIAS=180
# Falhas seguidas de leitura até declarar "SEM COMUNICAÇÃO"
FALHAS_PARA_OFFLINE=3

# ---- Acesso ----
# true = exige login. false = qualquer um na rede vê o painel (não recomendado)
LOGIN_OBRIGATORIO=true
# Validade da sessão em dias (TV da sala de controle fica logada)
SESSAO_DIAS=30

# Opcional: outro arquivo de cadastro dos silos (padrão: config/silos.json)
# ARQUIVO_SILOS=

# ---- Alertas no Telegram (opcional) ----
# Token do @BotFather e número do grupo (descubra com: npm run telegram -- descobrir)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# critico = só alarmes críticos e falta de comunicação; atencao = também alto/baixo
NOTIFICAR_SEVERIDADE=critico
# Repetir o aviso a cada N minutos enquanto ninguém reconhecer (0 = não repete)
NOTIFICAR_REPETIR_MIN=15
# Botão "Reconhecer" nas mensagens do Telegram
TELEGRAM_RECONHECER=true

# ---- Temperatura dos silos ----
# Tabela onde a IHM grava a temperatura (colunas id, Silo, Temperatura, data_hora). Vazio = desligado.
# O limite de cada silo fica em config/silos.json ("temperatura": { "sensor": 1, "maxC": 4 }).
TEMPERATURA_TABELA=temperatura_silo
TEMPERATURA_INTERVALO_S=30
# Leitura mais velha que isso aparece como "desatualizada"
TEMPERATURA_VALIDADE_MIN=10

# ---- Detecção de anomalias ----
# Variação maior que X% da capacidade entre duas leituras seguidas = "leitura suspeita" (0 = desliga)
ANOMALIA_SALTO_PCT=5
# Níveis intermediários exatamente iguais por N horas = "IHM pode ter parado de gravar" (0 = desliga)
ANOMALIA_CONGELADO_H=4

# ---- Relatórios ----
# Turnos do dia (o "dia de produção" começa no início do 1º turno)
TURNOS=06:00-14:00,14:00-22:00,22:00-06:00

# ---- Painel da fábrica (queijomáticas, UF1/UF2, recepção) ----
PAINEL_FABRICA=true

# ---- Backup diário ----
# Pasta de destino (pode ser de rede, ex.: \servidor\backups\silos). Padrão: data\backups
BACKUP_PASTA=
BACKUP_HORA=03:00
BACKUP_MANTER_DIAS=14
